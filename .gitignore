# Datasets, weights, and run outputs are not tracked -- except the two
# artifacts the paper says it releases: the density split lists and the
# per-bucket recall/precision tables the analyses reduce to.  (A child cannot
# be re-included under an excluded parent, hence `data/*` rather than `data/`.)
data/*
!data/splits/
results/*
!results/buckets/
!results/per_image/
!results/per_gt/
!results/masking/
weights/
runs/
experiments/
*.pt
*.pth
*.onnx
*.engine

# Cached predictions and analysis artifacts
*.jsonl
*.npz
*.npy

# Generated figures / tables
paper/
figures/
*.pdf
*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
