# Datasets, weights, and run outputs are not tracked -- except the artifacts
# the paper says it releases: the density split lists, the per-bucket tables,
# and the per-image, per-ground-truth and masking tables the analyses reduce
# to, plus the three deposited checkpoints.  (A child cannot be re-included
# under an excluded parent, hence `data/*` rather than `data/`.)
data/*
!data/splits/
results/*
!results/buckets/
!results/per_image/
!results/per_gt/
!results/masking/
weights/
runs/
experiments/
*.pt
!weights_release/*.pt
*.pth
*.onnx
*.engine

# Cached predictions and analysis artifacts
*.jsonl
*.npz
*.npy

# Generated figures / tables
paper/
figures/
*.pdf
*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
